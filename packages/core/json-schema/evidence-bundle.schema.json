{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "clientId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "transcript": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative to the client folder"
        },
        "format": {
          "type": "string",
          "enum": [
            "vtt",
            "txt"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "format",
        "sha256"
      ],
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-\\d{2,}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative to the client folder"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pdf",
              "docx",
              "xlsx",
              "eml",
              "txt"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "kind",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "redaction": {
      "type": "string",
      "enum": [
        "not_started",
        "awaiting_confirmation",
        "confirmed"
      ]
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "transcript_segment"
              },
              "id": {
                "type": "string",
                "pattern": "^T-\\d{4,}$"
              },
              "speaker": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id",
              "speaker",
              "start",
              "end",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "document_page"
              },
              "id": {
                "type": "string",
                "pattern": "^D-\\d{2,} p[1-9]\\d*$"
              },
              "documentId": {
                "type": "string",
                "pattern": "^D-\\d{2,}$"
              },
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id",
              "documentId",
              "page",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "spreadsheet_sheet"
              },
              "id": {
                "type": "string",
                "pattern": "^D-\\d{2,} s[1-9]\\d*$"
              },
              "documentId": {
                "type": "string",
                "pattern": "^D-\\d{2,}$"
              },
              "sheet": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "sheetName": {
                "type": "string",
                "minLength": 1
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cells": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^[A-Z]{1,3}[1-9]\\d*$"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "formula": {
                      "type": "string",
                      "format": "starts_with",
                      "pattern": "^=.*"
                    }
                  },
                  "required": [
                    "ref",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "kind",
              "id",
              "documentId",
              "sheet",
              "sheetName",
              "headers",
              "cells"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "email"
              },
              "id": {
                "type": "string",
                "pattern": "^D-\\d{2,}$"
              },
              "documentId": {
                "type": "string",
                "pattern": "^D-\\d{2,}$"
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "date": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "subject": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id",
              "documentId",
              "from",
              "to",
              "date",
              "subject",
              "text"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "clientId",
    "transcript",
    "documents",
    "redaction",
    "items"
  ],
  "additionalProperties": false
}
