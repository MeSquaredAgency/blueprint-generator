{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^([A-Z]{2,5})-([A-Z]{2,4})-(\\d{3})$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Verb first, e.g. 'Send monthly owner statements'"
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-\\d{3,}$"
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "frequency": {
      "type": "object",
      "properties": {
        "cadence": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "fortnightly",
            "monthly",
            "quarterly",
            "annual",
            "per_event",
            "ad_hoc",
            "unknown"
          ]
        },
        "detail": {
          "description": "e.g. 'first business day of the month', 'after every completed job'",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "cadence"
      ],
      "additionalProperties": false
    },
    "owner": {
      "type": "string",
      "enum": [
        "ai_role",
        "operator",
        "client_retained",
        "automation"
      ]
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ai_role",
          "operator",
          "client_retained",
          "automation"
        ]
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Exactly as the client names it"
          },
          "kind": {
            "type": "string",
            "enum": [
              "app",
              "folder",
              "login",
              "other"
            ]
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": false
      },
      "description": "Every app, folder or login touched"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "item"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "description": "Where it is saved or sent"
          }
        },
        "required": [
          "item",
          "destination"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "actor": {
            "type": "string",
            "enum": [
              "ai_role",
              "operator",
              "client_retained",
              "automation"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "description": "One action, verb first"
          },
          "system": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "anyOf": [
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(T-\\d{4,}|D-\\d{2,}( [ps][1-9]\\d*)?)$"
                }
              },
              {
                "type": "string",
                "const": "ASSUMED"
              }
            ]
          }
        },
        "required": [
          "n",
          "actor",
          "action",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "decisionPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1,
            "description": "From 'unless' / 'except when' in the transcript"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "anyOf": [
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(T-\\d{4,}|D-\\d{2,}( [ps][1-9]\\d*)?)$"
                }
              },
              {
                "type": "string",
                "const": "ASSUMED"
              }
            ]
          }
        },
        "required": [
          "condition",
          "action",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "qualityChecks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "escalation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "money",
              "legal",
              "complaints",
              "other"
            ]
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "contact": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "topic",
          "when",
          "contact"
        ],
        "additionalProperties": false
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "email",
              "invoice",
              "document",
              "other"
            ]
          },
          "link": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(T-\\d{4,}|D-\\d{2,}( [ps][1-9]\\d*)?)$"
            }
          }
        },
        "required": [
          "name",
          "kind",
          "link",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "scoring": {
      "type": "object",
      "properties": {
        "minutesPerRun": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "repeatability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "manualTime": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "buildEffort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "minutesPerRun",
        "repeatability",
        "manualTime",
        "buildEffort"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "operator_reviewed",
        "approved"
      ]
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "versionDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "reviewBy": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "id",
    "title",
    "taskId",
    "trigger",
    "frequency",
    "owner",
    "contributors",
    "systems",
    "inputs",
    "outputs",
    "steps",
    "decisionPoints",
    "qualityChecks",
    "escalation",
    "templates",
    "scoring",
    "status",
    "version",
    "versionDate",
    "reviewBy"
  ],
  "additionalProperties": false
}
