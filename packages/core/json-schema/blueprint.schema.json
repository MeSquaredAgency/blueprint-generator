{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "clientId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "clientName": {
      "type": "string",
      "minLength": 1
    },
    "clientPrefix": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "operator_reviewed",
        "approved"
      ]
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "versionDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "overview": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "industry": {
          "type": "string",
          "minLength": 1
        },
        "services": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "teamSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "what": {
                "type": "string",
                "minLength": 1
              },
              "approver": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "what",
              "approver"
            ],
            "additionalProperties": false
          },
          "description": "Who approves what"
        }
      },
      "required": [
        "summary",
        "industry",
        "services",
        "teamSize",
        "approvals"
      ],
      "additionalProperties": false
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "usedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "purpose",
          "usedBy"
        ],
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "holder": {
            "type": "string",
            "minLength": 1
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "responsibilities"
        ],
        "additionalProperties": false
      }
    },
    "calendar": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^TASK-\\d{3,}$"
          },
          "cadence": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "fortnightly",
              "monthly",
              "quarterly",
              "annual",
              "per_event",
              "ad_hoc",
              "unknown"
            ]
          },
          "when": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "taskId",
          "cadence"
        ],
        "additionalProperties": false
      }
    },
    "routing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^TASK-\\d{3,}$"
          },
          "sopId": {
            "type": "string",
            "pattern": "^([A-Z]{2,5})-([A-Z]{2,4})-(\\d{3})$"
          },
          "route": {
            "type": "string",
            "enum": [
              "ai_role",
              "operator",
              "client_retained",
              "automation"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "taskId",
          "route",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "clientId",
    "clientName",
    "clientPrefix",
    "status",
    "version",
    "versionDate",
    "overview",
    "systems",
    "roles",
    "calendar",
    "routing"
  ],
  "additionalProperties": false
}
